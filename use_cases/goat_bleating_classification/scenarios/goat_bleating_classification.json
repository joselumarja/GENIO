  "design_spaces": {
    "preproccessing_configuration": {
      "sample_rate":{
        "type": "choice",
        "values": [8000, 12000, 16000, 22050]
      },
      "window_sampling": {
        "parameters": {
          "window_size_samples": {
            "type": "choice",
            "values": [4000, 8000, 12000, 16000, 20000, 22050, 24000, 28000, 32000]
          },
          "window_hop_samples": {
            "type": "choice",
            "values": [2000, 4000, 6000, 8000, 10000, 11025, 12000, 14000, 16000]
          }
        },
        "constraints": [
          "@window_hop_samples <= @window_size_samples"
        ]
      },
      
      "FFT_size": {
        "type": "choice",
        "values": [256, 512, 1024, 2048, 4096]
      },
      "Hop_length": {
        "type": "integer_range",
        "start": 128,
        "stop": 1025,
        "step": 128
      },
      "MEL_band_number": {
        "type": "integer_range",
        "start": 16,
        "stop": 161,
        "step": 16
      },
      "band_limit_hz": {
