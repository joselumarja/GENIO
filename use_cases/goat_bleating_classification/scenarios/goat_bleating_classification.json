            "stop": 301,
            "step": 50
          },
          "upper_band_limit_hz":{
            "type": "integer_range",
            "start": 2000,
            "stop": 8001,
            "step": 1000
          }
        },
        "constraints": [
          "@lower_band_limit_hz < @upper_band_limit_hz"
        ]
      }
    },
