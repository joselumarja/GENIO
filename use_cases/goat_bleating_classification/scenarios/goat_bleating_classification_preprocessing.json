{
  "id": "goat_bleating_classification",
  "description": "Goat bleating preprocessing and VGGish-style neural architecture search space",
  "resources": {
    "datasets": {
      "train": "",
      "test": ""
    }
  },
  "design_spaces": {
    "preproccessing_configuration": {
      "sample_rate":{
        "type": "choice",
        "values": [16000, 22050, 44100]
      },
      
      "window_size_samples_ratio": {
        "type": "choice",
        "values": [0.25, 0.5, 0.75, 1, 1.5, 2]
      },

      "window_hop_samples_ratio": {
        "type": "choice",
        "values": [0.25, 0.5, 0.75, 1]
      },
      
      "FFT_size": {
        "type": "choice",
        "values": [512, 1024, 2048, 4096]
      },
      "Hop_length_ratio": {
        "type": "choice",
        "values": [0.25, 0.5]
      },
      "MEL_band_number": {
        "type": "choice",
        "values": [8, 16, 32, 48, 64, 96, 128]
      },
      "band_limit_hz": {
        "parameters": {
          "lower_band_limit_hz": {
            "type": "choice",
            "values": [0, 50, 100, 200, 300]
          },
          "upper_band_limit_hz":{
            "type": "integer_range",
            "start": 2000,
            "stop": 8001,
            "step": 1000
          }
        },
        "constraints": [
          "@lower_band_limit_hz < @upper_band_limit_hz"
        ]
      }
    }
  }
}
