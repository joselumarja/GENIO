              "kernel_size": {"type": "choice", "values": [3, 5]},
              "activation": {"type": "choice", "values": ["relu", "elu"]},
              "pool_type": {"type": "choice", "values": ["max", "average"]},
              "pool_size": {"type": "constant", "value": 2}
            }
          }
        ]
      },
      {
        "slot": 3,
        "candidates": [
          {"stage": "nop"},
          {
            "stage": "conv_block",
            "parameters": {
              "filters": {"type": "choice", "values": [256, 512]},
              "convolutions": {"type": "choice", "values": [1, 2]},
