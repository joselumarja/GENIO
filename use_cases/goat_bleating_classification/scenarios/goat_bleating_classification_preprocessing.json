{
  "id": "goat_bleating_classification",
  "description": "Goat bleating preprocessing and VGGish-style neural architecture search space",
  "resources": {
    "datasets": {
      "train": "",
      "test": ""
    }
  },
  "design_spaces": {
    "preproccessing_configuration": {
      "sample_rate":{
        "type": "choice",
        "values": [8000, 12000, 16000, 22050]
      },
      "window_sampling": {
        "parameters": {
          "window_size_samples": {
            "type": "choice",
            "values": [4000, 8000, 12000, 16000, 20000, 22050, 24000, 28000, 32000]
          },
          "window_hop_samples": {
            "type": "choice",
            "values": [2000, 4000, 6000, 8000, 10000, 11025, 12000, 14000, 16000]
          }
        },
        "constraints": [
          "@window_hop_samples <= @window_size_samples"
        ]
      },
      
      "FFT_size": {
        "type": "choice",
        "values": [256, 512, 1024, 2048, 4096]
      },
      "Hop_length": {
        "type": "integer_range",
        "start": 128,
        "stop": 1025,
        "step": 128
      },
      "MEL_band_number": {
        "type": "integer_range",
        "start": 16,
        "stop": 161,
        "step": 16
      },
      "band_limit_hz": {
        "parameters": {
          "lower_band_limit_hz": {
            "type": "integer_range",
            "start": 0,
            "stop": 301,
            "step": 50
          },
          "upper_band_limit_hz":{
            "type": "integer_range",
            "start": 2000,
            "stop": 8001,
            "step": 1000
          }
        },
        "constraints": [
          "@lower_band_limit_hz < @upper_band_limit_hz"
        ]
      }
    },
    "pipeline": [
      {
        "slot": 0,
        "candidates": [
          {
            "stage": "conv_block",
            "parameters": {
              "filters": {"type": "integer_range", "start": 32, "stop": 129, "step": 32},
              "convolutions": {"type": "constant", "value": 1},
              "kernel_size": {"type": "choice", "values": [3, 5]},
              "activation": {"type": "choice", "values": ["relu", "elu"]},
              "pool_type": {"type": "constant", "value": "max"},
              "pool_size": {"type": "constant", "value": 2}
            }
          },
          {
            "stage": "separable_conv_block",
            "parameters": {
              "filters": {"type": "choice", "values": [32, 64, 128]},
              "convolutions": {"type": "constant", "value": 1},
              "kernel_size": {"type": "choice", "values": [3, 5]},
              "activation": {"type": "choice", "values": ["relu", "elu"]},
              "pool_type": {"type": "constant", "value": "max"},
              "pool_size": {"type": "constant", "value": 2}
            }
          }
        ]
      },
      {
        "slot": 1,
        "candidates": [
          {
            "stage": "conv_block",
            "parameters": {
              "filters": {"type": "choice", "values": [64, 128, 256]},
