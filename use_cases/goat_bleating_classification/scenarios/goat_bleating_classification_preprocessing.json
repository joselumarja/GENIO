              "kernel_size": {"type": "choice", "values": [3, 5]},
              "activation": {"type": "constant", "value": "relu"},
              "pool_type": {"type": "choice", "values": ["max", "average"]},
              "pool_size": {"type": "constant", "value": 2}
            }
          },
          {
            "stage": "separable_conv_block",
            "parameters": {
              "filters": {"type": "choice", "values": [64, 128, 256]},
              "convolutions": {"type": "choice", "values": [1, 2]},
              "kernel_size": {"type": "choice", "values": [3, 5]},
              "activation": {"type": "constant", "value": "relu"},
              "pool_type": {"type": "choice", "values": ["max", "average"]},
              "pool_size": {"type": "constant", "value": 2}
            }
          }
        ]
      },
      {
        "slot": 2,
        "candidates": [
          {"stage": "nop"},
          {
            "stage": "conv_block",
            "parameters": {
              "filters": {"type": "choice", "values": [128, 256]},
