{
  "id": "conv_block",
  "name": "Convolutional Block",
  "category": "neural_network",
  "description": "Apply convolution, activation, and pooling to an input tensor.",
  "parameters": [
    {
      "name": "filters",
      "token": "@FILTERS",
      "type": "integer",
      "description": "Number of convolutional output filters."
    },
    {
      "name": "kernel_rows",
      "token": "@K_ROWS",
      "type": "integer",
      "description": "Convolution kernel height."
    },
    {
      "name": "kernel_cols",
      "token": "@K_COLS",
      "type": "integer",
      "description": "Convolution kernel width."
    },
    {
      "name": "activation",
      "token": "@ACTIVATION",
      "type": "enum",
      "description": "Activation function applied after convolution."
    },
    {
      "name": "pool_type",
      "token": "@POOL_TYPE",
      "type": "enum",
      "description": "Pooling operation (max or average)."
    },
    {
      "name": "pool_size",
      "token": "@POOL_SIZE",
      "type": "integer",
      "description": "Pooling window size."
    }
  ],
  "interface": {
    "inputs": [
      {
        "format": "tensor",
        "token": "@input_0"
      }
    ],
    "outputs": [
      {
        "format": "tensor",
        "token": "@output_0"
      }
    ]
  },
  "implementations": {
    "functional": {
      "tensorflow": "implementations/functional/tensorflow/conv_block.json"
    }
  },
  "composer_resolved": [],
  "constraints": [
    "@FILTERS > 0",
    "@K_ROWS > 0",
    "@K_COLS > 0",
    "is_odd(@K_ROWS)",
    "is_odd(@K_COLS)",
    "@POOL_SIZE > 0"
  ]
}
