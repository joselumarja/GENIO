{
  "id": "morph_close",
  "name": "Morphological Close",
  "category": "morphology",
  "description": "Apply morphological closing using dilation followed by erosion.",
  "parameters": [
    {
      "name": "kernel_shape",
      "token": "@K_SHAPE",
      "type": "enum",
      "description": "Structuring element shape."
    },
    {
      "name": "kernel_rows",
      "token": "@K_ROWS",
      "type": "integer",
      "description": "Kernel height."
    },
    {
      "name": "kernel_cols",
      "token": "@K_COLS",
      "type": "integer",
      "description": "Kernel width."
    },
    {
      "name": "iterations",
      "token": "@ITERATIONS",
      "type": "integer",
      "description": "Number of morphology iterations."
    }
  ],
  "interface": {
    "inputs": [
      {
        "format": "image",
        "token": "@input_0"
      }
    ],
    "outputs": [
      {
        "format": "image",
        "token": "@output_0"
      }
    ]
  },
  "implementations": {
    "hls": {
      "vitis_vision": "implementations/hls/vitis_vision/morph_close.json"
    },
    "functional": {
      "opencv": "implementations/functional/opencv/morph_close.json"
    }
  },
  "composer_resolved": [
    {
      "name": "kernel",
      "token": "@kernel",
      "description": "Structuring element generated by composer/wrapper."
    }
  ],
  "constraints": [
    "is_odd(@K_COLS)",
    "is_odd(@K_ROWS)",
    "@K_COLS > 1",
    "@K_ROWS > 1"
  ]
}
